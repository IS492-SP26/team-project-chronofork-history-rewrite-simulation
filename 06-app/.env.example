# ============================================================
# ChronoFork — Environment Variables Template
# Copy this file to .env (Chrono-Server) or .env.local (Chrono-WebNext)
# NEVER commit .env or .env.local to version control
# ============================================================

# ------------------------------------------------------------
# Chrono-Server (backend)
# ------------------------------------------------------------

# OpenAI API key — required for all LLM calls (GPT-5.1 model)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...

# ------------------------------------------------------------
# Chrono-WebNext (Next.js frontend)
# ------------------------------------------------------------

# WebSocket endpoint of the running Chrono-Server
# Development default: ws://localhost:8000/ws
# Production:          wss://your-server-domain/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
